{
  "id": "glixo.extension.jira-issues",
  "name": "Jira issues",
  "kind": "extension",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "description": "Issue list/detail UI wired to glixo.work.jira HTTP API.",
  "runtime": {
    "kind": "node",
    "version": "20"
  },
  "entry": {
    "command": "echo",
    "args": ["extension-bundled-in-app"]
  },
  "capabilities": [
    "glixo.ui.route.jira",
    "glixo.jira.issues"
  ],
  "requires": [
    "ui",
    "capability.glixo.jira.issues"
  ],
  "components": [
    {
      "id": "issues-view",
      "cell": "client",
      "scope": "user",
      "runtime": "node",
      "entry": {
        "command": "echo",
        "args": ["extension-bundled-in-app"]
      },
      "requires": ["capability.glixo.jira.issues"],
      "capabilities": ["glixo.ui.route.jira"],
      "placement": {
        "kind": "user",
        "required": true
      }
    }
  ],
  "contributes": {
    "capabilities": [
      "glixo.ui.route.jira",
      "glixo.jira.issues"
    ],
    "routes": [
      {
        "id": "glixo.jira.issues.route",
        "path": "/jira",
        "title": "Jira issues",
        "component": "JiraIssues"
      }
    ],
    "sidebarViews": [
      {
        "id": "glixo.jira.issues.sidebar",
        "slot": "infostream.sidebar",
        "title": "Jira issues",
        "icon": "albums-outline",
        "component": "JiraIssues"
      }
    ],
    "dataSources": [
      {
        "id": "glixo.jira.issues.source",
        "title": "Jira issues",
        "scopes": ["user", "workspace"],
        "capability": "glixo.jira.issues",
        "icon": "albums-outline",
        "sync": "realtime"
      }
    ],
    "aiContextProviders": [
      {
        "id": "glixo.jira.issues.context",
        "title": "Jira issues",
        "scopes": ["user", "workspace", "session"],
        "capability": "glixo.jira.issues",
        "icon": "albums-outline",
        "description": "Adds issue state, board context, and sprint changes to agent runs."
      }
    ]
  },
  "artifacts": [
    {
      "rid": "any",
      "url": "glixo-extension-jira-issues",
      "sha256": "dev-placeholder"
    }
  ],
  "updateChannels": ["stable"]
}
