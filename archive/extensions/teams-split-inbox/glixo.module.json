{
  "id": "glixo.extension.teams-split-inbox",
  "name": "Teams split inbox",
  "description": "Default split conversations screen - consumes glixo.messaging.teams service API.",
  "kind": "extension",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": {
    "command": "echo",
    "args": ["extension-bundled-in-app"]
  },
  "capabilities": ["glixo.ui.route.teams"],
  "requires": [
    "ui",
    "logging",
    "capability.glixo.teams.conversations"
  ],
  "config": {
    "fields": [
      {
        "key": "teamsServiceUrl",
        "label": "Teams service URL",
        "type": "text",
        "defaultValue": "http://127.0.0.1:6120",
        "helpText": "Loopback URL of glixo.messaging.teams module process."
      }
    ]
  },
  "ui": {
    "routes": [
      { "path": "/teams-live", "component": "TeamsSplitInboxExtension" }
    ]
  },
  "components": [
    {
      "id": "split-inbox-view",
      "cell": "client",
      "scope": "user",
      "runtime": "node",
      "entry": {
        "command": "echo",
        "args": ["extension-bundled-in-app"]
      },
      "requires": ["capability.glixo.teams.conversations"],
      "capabilities": ["glixo.ui.route.teams"],
      "placement": {
        "kind": "user",
        "required": true
      }
    }
  ],
  "contributes": {
    "capabilities": [
      "glixo.ui.route.teams",
      "glixo.teams.conversations"
    ],
    "routes": [
      {
        "id": "glixo.teams.splitInbox.route",
        "path": "/teams-live",
        "title": "Teams split inbox",
        "component": "TeamsSplitInboxExtension"
      }
    ],
    "sidebarViews": [
      {
        "id": "glixo.teams.splitInbox.sidebar",
        "slot": "infostream.sidebar",
        "title": "Teams",
        "icon": "chatbubbles-outline",
        "component": "TeamsSplitInboxExtension"
      }
    ],
    "dataSources": [
      {
        "id": "glixo.teams.conversations.source",
        "title": "Teams conversations",
        "scopes": ["user", "workspace"],
        "capability": "glixo.teams.conversations",
        "icon": "chatbubbles-outline",
        "sync": "realtime"
      }
    ],
    "aiContextProviders": [
      {
        "id": "glixo.teams.conversations.context",
        "title": "Teams conversations",
        "scopes": ["user", "workspace", "session"],
        "capability": "glixo.teams.conversations",
        "icon": "chatbubbles-outline",
        "description": "Adds recent Teams conversations, mentions, and channel activity to agent runs."
      }
    ],
    "settingsPanels": [
      {
        "id": "glixo.teams.splitInbox.settings",
        "slot": "settings",
        "title": "Teams split inbox",
        "icon": "chatbubbles-outline",
        "component": "TeamsSplitInboxSettings"
      }
    ]
  },
  "artifacts": [
    { "rid": "any", "url": "glixo-extension-teams-split-inbox", "sha256": "dev-placeholder" }
  ],
  "updateChannels": ["stable"]
}
