{
  "id": "glixo.contacts.google",
  "name": "Google Contacts",
  "description": "Google Contacts sync (alpha scaffold).",
  "kind": "service",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["dist/index.js"], "workingDirectory": "." },
  "capabilities": ["glixo.contacts.sync", "glixo.contacts.read"],
  "requires": ["logging", "health", "secrets.google", "relationalDb.module"],
  "health": { "path": "/health", "intervalSeconds": 60 },
  "config": { "fields": [{ "key": "port", "label": "Service port", "type": "number", "defaultValue": "6133" }] },
  "artifacts": [{ "rid": "any", "url": "glixo-contacts-google", "sha256": "dev-placeholder" }]
}
