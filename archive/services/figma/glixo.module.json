{
  "id": "glixo.design.figma",
  "name": "Figma",
  "description": "Figma design-source extension scaffold for Infostream workspaces.",
  "kind": "service",
  "version": "0.0.0-stub",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["dist/index.js"], "workingDirectory": "." },
  "requires": ["logging", "health", "relationalDb.module", "events", "secrets.figma"],
  "capabilities": ["glixo.design.figma.files", "glixo.design.figma.comments"],
  "health": { "path": "/health", "intervalSeconds": 60 },
  "artifacts": [{ "rid": "any", "url": "glixo-design-figma", "sha256": "dev-placeholder" }]
}
