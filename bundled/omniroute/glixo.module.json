{
  "id": "glixo.providers.omniroute",
  "name": "OmniRoute LLM Provider",
  "kind": "extension",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "bundled": true,
  "description": "Connects Glixo Code to an existing OmniRoute multi-provider router through its OpenAI-compatible API.",
  "runtime": {
    "kind": "node",
    "version": "20"
  },
  "entry": {
    "command": "echo",
    "args": ["declarative-llm-provider"]
  },
  "capabilities": [
    "glixo.llm.provider.omniroute"
  ],
  "requires": [
    "capability.glixo.llmProviders.register"
  ],
  "contributes": {
    "llmProviders": [
      {
        "id": "omniroute",
        "label": "OmniRoute",
        "description": "Route requests through an OmniRoute service already running on the target machine.",
        "icon": "git-network-outline",
        "contractId": "glixo.adapter.llm.v1",
        "implementationId": "openai-compatible",
        "credentialFields": [
          {
            "id": "baseUrl",
            "label": "Base URL",
            "type": "url",
            "required": true,
            "defaultValue": "http://127.0.0.1:20128/v1",
            "helpText": "The OpenAI-compatible API exposed by an existing OmniRoute installation."
          },
          {
            "id": "apiKey",
            "label": "API key",
            "type": "secret",
            "required": false,
            "secret": true,
            "helpText": "Optional when OmniRoute authentication is disabled."
          }
        ],
        "modelDiscovery": {
          "kind": "openai-compatible-models",
          "path": "/models"
        },
        "modelRouting": {
          "families": ["omniroute"],
          "patterns": [],
          "servesAllFamilies": true
        },
        "capabilities": ["chat", "streaming", "tools", "reasoning"]
      }
    ]
  },
  "updateChannels": ["stable"]
}
