{
  "id": "glixo.samples.agxos-workspace-watch",
  "name": "Agxos Workspace Watch",
  "description": "Reference coded app that polls workspace file listings and git status, with tray, notify, and window title integration for Agxos extension authors.",
  "icon": "assets/icon.svg",
  "images": [
    {
      "url": "assets/screenshot.svg",
      "alt": "Workspace Watch app preview",
      "caption": "Live workspace file tree with git status overlay and configurable refresh.",
      "type": "screenshot"
    }
  ],
  "changelog": {
    "entries": [
      {
        "version": "0.1.0",
        "date": "2026-06-30",
        "title": "Workspace Watch author sample",
        "description": "Adds a sandboxed coded app exercising fs.list, fs.gitStatus, storage, notify, tray, and window APIs plus a replay demo."
      }
    ]
  },
  "kind": "extension",
  "version": "0.1.0",
  "protocolVersion": "0",
  "runtime": {
    "kind": "node",
    "version": "20"
  },
  "entry": {
    "command": "echo",
    "args": [
      "client-bundled-in-app"
    ]
  },
  "capabilities": [
    "glixo.agxos.apps.register",
    "glixo.agxos.workspace.watch"
  ],
  "requires": [
    "ui",
    "capability.glixo.agxos.apps.register",
    "capability.glixo.agxos.windows.control",
    "capability.glixo.agxos.notifications.create",
    "capability.glixo.agxos.tray.contribute",
    "filesystem.workspace.read"
  ],
  "permissions": [],
  "health": {
    "path": "/health",
    "intervalSeconds": 30
  },
  "components": [
    {
      "id": "workspace-watch-app",
      "cell": "client",
      "scope": "session",
      "runtime": "node",
      "entry": {
        "command": "echo",
        "args": [
          "client-bundled-in-app"
        ]
      },
      "requires": [
        "ui",
        "capability.glixo.agxos.apps.register",
        "capability.glixo.agxos.windows.control",
        "capability.glixo.agxos.notifications.create",
        "capability.glixo.agxos.tray.contribute",
        "filesystem.workspace.read"
      ],
      "capabilities": [
        "glixo.agxos.apps.register"
      ],
      "placement": {
        "kind": "session",
        "required": false
      }
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "glixo.samples.agxos-workspace-watch.open",
        "slot": "agxos.toolbar",
        "title": "Workspace Watch",
        "icon": "folder-open-outline",
        "command": "glixo.agxos.windowAction",
        "priority": 36,
        "input": {
          "appId": "workspace.watch",
          "command": "show",
          "notify": {
            "title": "Workspace Watch",
            "body": "Polling workspace files and git status.",
            "kind": "info"
          }
        }
      }
    ],
    "agxos": {
      "apps": [
        {
          "id": "workspace.watch",
          "name": "Workspace Watch",
          "icon": "WW",
          "accent": "#0A84FF",
          "template": "app",
          "entry": "dist/app.js",
          "width": 560,
          "height": 480,
          "actions": [
            {
              "id": "open",
              "description": "Open or focus Workspace Watch."
            },
            {
              "id": "refresh",
              "description": "Refresh the file tree and git overlay."
            },
            {
              "id": "notify",
              "description": "Show a sample notification from the agent."
            }
          ]
        }
      ]
    }
  },
  "demos": [
    {
      "id": "intro",
      "kind": "replay",
      "title": "Workspace Watch intro",
      "replayPath": "demo/demo.replay.json"
    }
  ],
  "artifacts": [
    {
      "rid": "any",
      "url": "artifacts/agxos-workspace-watch-0.1.0.zip",
      "sha256": "09e1508e05b31eef8bdeb31e58e2e90359bbeef0ace2fccc68942b243adeae83"
    }
  ],
  "updateChannels": [
    "stable"
  ]
}
