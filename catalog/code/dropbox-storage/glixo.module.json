{
  "id": "glixo.storage.dropbox",
  "name": "Dropbox Storage Provider",
  "publisher": "Glixo Community",
  "kind": "extension",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "description": "Adds Dropbox as an installable storage provider for Glixo file replication and short-lived attachment links.",
  "runtime": {
    "kind": "node",
    "version": "20"
  },
  "entry": {
    "command": "echo",
    "args": [
      "declarative-storage-provider"
    ]
  },
  "capabilities": [
    "glixo.storage.provider.dropbox"
  ],
  "requires": [
    "capability.glixo.storage.providers.register"
  ],
  "permissions": [
    "network.dropbox"
  ],
  "contributes": {
    "storageProviders": [
      {
        "id": "dropbox",
        "label": "Dropbox",
        "description": "Use Dropbox for Glixo replication and short-lived raw download links.",
        "icon": "cube-outline",
        "contractId": "glixo.adapter.storage.v1",
        "implementationId": "dropbox",
        "credentialFields": [
          {
            "id": "oauth",
            "label": "Dropbox account",
            "type": "oauth",
            "required": true,
            "secret": true,
            "helpText": "Core opens the Dropbox sign-in callback and stores the token bundle."
          },
          {
            "id": "clientId",
            "label": "Client ID override",
            "type": "text",
            "required": false,
            "helpText": "Optional advanced override for a user-owned Dropbox app."
          }
        ],
        "oauth": {
          "authorizationUrl": "https://www.dropbox.com/oauth2/authorize",
          "tokenUrl": "https://api.dropboxapi.com/oauth2/token",
          "scopes": [
            "files.content.read",
            "files.content.write",
            "files.metadata.read",
            "files.metadata.write"
          ],
          "redirectPath": "/v1/storage/oauth/callback",
          "pkce": true
        },
        "capabilities": [
          "replication",
          "publicUrl",
          "cloud",
          "highAvailability"
        ]
      }
    ]
  },
  "artifacts": [
    {
      "rid": "any",
      "url": "artifacts/dropbox-storage-0.1.0-alpha.zip",
      "sha256": "b655abcca5bfa3de9ae28eae449441565a07a1226ee8e5ffb789fbf92cd9d168"
    }
  ],
  "updateChannels": [
    "stable"
  ]
}
