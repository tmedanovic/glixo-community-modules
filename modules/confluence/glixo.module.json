{
  "id": "glixo.work.confluence",
  "name": "Confluence",
  "description": "Confluence data-source extension scaffold for Infostream workspaces.",
  "kind": "service",
  "version": "0.0.0-stub",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["dist/index.js"], "workingDirectory": "." },
  "requires": ["logging", "health", "relationalDb.module", "events", "secrets.atlassian"],
  "capabilities": ["glixo.work.confluence.pages", "glixo.work.confluence.search"],
  "health": { "path": "/health", "intervalSeconds": 60 },
  "artifacts": [{ "rid": "any", "url": "glixo-work-confluence", "sha256": "dev-placeholder" }]
}
