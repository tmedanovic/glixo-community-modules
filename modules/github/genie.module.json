{
  "id": "glixo.work.github",
  "name": "GitHub",
  "description": "GitHub repos and pull requests — alpha service extracted from genie-server github sync.",
  "kind": "service",
  "version": "0.1.0-alpha",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["dist/index.js"], "workingDirectory": "." },
  "capabilities": ["vcs.repos", "vcs.pullRequests", "vcs.sync"],
  "requires": [
    "logging",
    "health",
    "relationalDb.module",
    "config",
    "secrets.github",
    "jobs",
    "events",
    "capability.genie.work.items.upsert"
  ],
  "permissions": ["network.github-api"],
  "health": { "path": "/health", "intervalSeconds": 60 },
  "config": {
    "fields": [{ "key": "port", "label": "HTTP port", "type": "number", "defaultValue": "6131" }]
  },
  "artifacts": [{ "rid": "any", "url": "glixo-work-github", "sha256": "dev-placeholder" }],
  "updateChannels": ["stable", "beta"]
}
