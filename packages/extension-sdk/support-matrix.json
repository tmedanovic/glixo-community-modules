      "world": "glixo:llm-provider-compat/provider-compat@3.0.0",
      "artifact": "dist/glixo-extension.component.wasm",
      "build": {
        "steps": [
          {
            "tool": "cargo",
            "args": [
              "build",
              "--locked",
              "--release",
              "--target",
              "wasm32-wasip2",
              "--target-dir",
              "target"
            ],
            "cwd": ".",
            "output": "target/wasm32-wasip2/release/glixo_ollama_provider.wasm"
          },
          {
            "tool": "node",
            "args": [
              "scripts/copy-artifact.mjs",
              "target/wasm32-wasip2/release/glixo_ollama_provider.wasm",
              "dist/glixo-extension.component.wasm"
            ],
            "cwd": ".",
            "output": "dist/glixo-extension.component.wasm"
          }
        ],
        "verification": {
          "tool": "wasm-tools",
          "args": [
            "component",
            "wit",
            "dist/glixo-extension.component.wasm"
          ],
          "output": "dist/glixo-extension.component.wasm"
        }
      },
