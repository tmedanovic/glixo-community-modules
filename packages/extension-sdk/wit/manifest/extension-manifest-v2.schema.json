{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.glixo.dev/extension-manifest/v2.json",
  "title": "Extension Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "metadata"],
  "allOf": [{
    "if": {
      "required": ["contributions"],
      "properties": { "contributions": {
        "required": ["implements"],
        "properties": { "implements": { "type": "array", "contains": {
          "type": "object", "required": ["contract"], "properties": { "contract": { "pattern": "^agent-runtime@" } }
        } } }
      } }
    },
    "then": {
      "required": ["permissions"],
      "properties": { "permissions": {
        "required": ["requested"],
        "properties": { "requested": { "contains": {
          "type": "object", "required": ["id"], "properties": { "id": { "const": "agent.run" } }
        } } }
      } }
    }
  }],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "metadata": { "$ref": "#/$defs/ExtensionMetadata" },
    "compatibility": { "$ref": "#/$defs/ExtensionCompatibility" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExtensionArtifact" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExtensionComponent" }
    },
    "cells": {
      "type": "array",
      "items": { "type": "string", "enum": ["server", "desktop", "os", "mobile", "browser"] }
    },
    "permissions": { "$ref": "#/$defs/ExtensionPermissions" },
    "events": { "$ref": "#/$defs/ExtensionEvents" },
    "configurations": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExtensionConfigurationRef" }
    },
    "contributions": { "$ref": "#/$defs/ExtensionContributions" },
    "nativeDependencies": { "type": "array", "items": { "$ref": "#/$defs/ExtensionNativeDependency" } }
  },
  "$defs": {
    "ExtensionNativeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version", "required", "serviceAbi", "capabilities", "artifacts"],
      "properties": {
        "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "required": { "type": "boolean" },
        "serviceAbi": { "type": "string", "anyOf": [
          { "const": "glixo.shift-jira-import.v1" },
          { "const": "glixo.shift-microsoft-import.v1" },
          { "const": "glixo.shift-confluence-read.v1" },
          { "pattern": "^[a-z0-9][a-z0-9.-]*:[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*@\\d+\\.\\d+\\.\\d+$" }
        ] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$" } },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ExtensionNativeDependencyArtifact" } }
      }
    },
    "ExtensionNativeDependencyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rid", "url", "sha256"],
      "properties": {
        "rid": { "type": "string", "pattern": "^[a-z0-9]+-[a-z0-9]+$" },
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "JiraAssignedImportNativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "nativeDependencyId", "serviceAbi"],
      "properties": {
        "operationId": { "const": "jira.assigned.import.step" },
        "nativeDependencyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "serviceAbi": { "const": "glixo.shift-jira-import.v1" }
      }
    },
    "MicrosoftImportNativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "nativeDependencyId", "serviceAbi"],
      "properties": {
        "operationId": { "enum": ["outlook.mail.import.step", "outlook.calendar.import.step", "teams.messages.import.step"] },
        "nativeDependencyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "serviceAbi": { "const": "glixo.shift-microsoft-import.v1" }
      }
    },
    "ConfluenceQueryNativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "nativeDependencyId", "serviceAbi"],
      "properties": {
        "operationId": { "const": "confluence.context.query" },
        "nativeDependencyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "serviceAbi": { "const": "glixo.shift-confluence-read.v1" }
      }
    },
    "InstalledEntityActionCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordType", "inputName"],
      "properties": {
        "recordType": { "$ref": "https://schemas.glixo.dev/extensions/ui/entity-action-context.json#/$defs/ExtensionEntityTypeSelector" },
        "inputName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$", "not": { "enum": ["constructor", "prototype", "__proto__"] } }
      }
    },
    "ExtensionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "ExtensionCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "schema": { "type": "integer", "const": 2 },
        "witWorld": { "type": "string" },
        "uiBridge": { "type": "string" },
        "packageSignature": { "type": "string" },
        "trustTier": { "type": "string", "enum": ["marketplace", "local-trusted", "admin"] },
        "compositionKind": { "$ref": "#/$defs/PackageCompositionKind" },
        "productId": { "type": "string", "enum": ["glixo-code", "glixo-os", "glixo-mobile", "glixo-workflow-designer"] }
      }
    },
    "ExtensionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.).+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/wasm",
            "text/html",
            "text/css",
            "text/javascript",
            "application/json",
            "image/png",
            "image/svg+xml",
            "image/webp",
            "application/json+a2ui",
            "application/json+theme-tokens"
          ]
        }
      }
    },
    "ExtensionComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cell", "runtime"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cell": { "type": "string", "enum": ["server", "desktop", "os", "mobile", "browser"] },
        "runtime": { "type": "string", "enum": ["wasm-component", "sandboxed-web", "local-process"] },
        "artifact": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "world": { "type": "string" },
        "entry": { "type": "string" }
      }
    },
    "ExtensionPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "array",
          "items": { "$ref": "#/$defs/RequestedPermission" }
        }
      }
    },
    "RequestedPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "object", "additionalProperties": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ExtensionEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publish": { "type": "array", "items": { "$ref": "#/$defs/EventPublishDeclaration" } },
        "subscribe": { "type": "array", "items": { "$ref": "#/$defs/EventSubscribeDeclaration" } }
      }
    },
    "EventPublishDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemaVersion", "scope", "reason"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "schema": { "type": "string" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "scope": { "type": "string", "enum": ["account", "workspace", "project", "installation"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "EventSubscribeDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemaVersions", "scope", "reason"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "schemaVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "scope": { "type": "string", "enum": ["account", "workspace", "project", "installation"] },
        "delivery": { "type": "string", "enum": ["durable", "wake"] },
        "component": { "type": "string" },
        "handler": { "type": "string" },
        "publisherPackageId": { "type": "string", "minLength": 1 },
        "publisherKinds": {
          "type": "array",
          "items": { "type": "string", "enum": ["extension", "extension-service", "platform", "workflow", "application"] }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ExtensionConfigurationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "schema", "schemaDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "enum": ["installation", "account", "user", "workspace", "project", "session"] },
        "schema": { "type": "string" },
        "schemaDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "ui": { "type": "string" },
        "uiDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [{ "if": { "required": ["ui"] }, "then": { "required": ["uiDigest"] } }]
    },
    "ExtensionContributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implements": { "type": "array", "items": { "$ref": "#/$defs/ImplementsEntry" } }
      }
    },
    "ContractReference": {
      "type": "string",
      "description": "<contract-id>@<major>, for example llm-provider@1. The contract id names a definition under contracts/extensions/contracts/<contract-id>.contract.json.",
      "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"
    },
    "ImplementsRuntime": {
      "type": "string",
      "description": "How the host executes an implementation. workflow, declarative-http and sandboxed-process are accepted by this schema but rejected by the validator until the host ships them.",
      "enum": [
        "wasm-component", "workflow", "declarative-http", "sandboxed-process", "mcp", "piece",
        "tools-host", "native-operation", "local-process", "sandboxed-web", "declarative"
      ]
    },
    "ImplementsEntry": {
      "type": "object",
      "description": "One implementation of a versioned extension contract. contributions.implements is the only way to declare contributions. fields carries the contract-specific contributionFields and is validated against the contract definition, entry carries runtime-specific wiring (for example workflowPackage and operations).",
      "additionalProperties": false,
      "required": ["id", "contract", "runtime"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "contract": { "$ref": "#/$defs/ContractReference" },
        "runtime": { "$ref": "#/$defs/ImplementsRuntime" },
        "component": { "type": "string", "minLength": 1 },
        "world": { "type": "string" },
        "entry": { "type": "object" },
        "fields": { "type": "object" },
        "configuration": { "type": "string" },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "targetApplications": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^app\\.[a-z0-9][a-z0-9.-]{1,127}$" } },
        "context": { "type": "string", "enum": ["machine", "project", "session"] }
      },
      "allOf": [{
        "if": { "properties": { "runtime": { "enum": ["wasm-component", "sandboxed-web", "local-process"] } }, "required": ["runtime"] },
        "then": { "required": ["component"] }
      }]
    },
    "StatusButtonRunAction": {
      "type": "object", "additionalProperties": false, "required": ["runWorkflow"],
      "properties": { "runWorkflow": { "type": "string", "pattern": "^winst_[A-Za-z0-9]+$" } }
    },
    "StatusButtonPanelAction": {
      "type": "object", "additionalProperties": false, "required": ["openPanel"],
      "properties": { "openPanel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" } }
    },
    "StatusButtonSimpleAction": {
      "anyOf": [{ "$ref": "#/$defs/StatusButtonRunAction" }, { "$ref": "#/$defs/StatusButtonPanelAction" }]
    },
    "StatusButtonMenuEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "action"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 96 },
        "action": { "$ref": "#/$defs/StatusButtonSimpleAction" }
      }
    },
    "StatusButtonMenuAction": {
      "type": "object", "additionalProperties": false, "required": ["menu"],
      "properties": { "menu": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/StatusButtonMenuEntry" } } }
    },
    "StatusButtonAction": {
      "anyOf": [{ "$ref": "#/$defs/StatusButtonSimpleAction" }, { "$ref": "#/$defs/StatusButtonMenuAction" }]
    },
    "StatusButtonBinding": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "key"], "properties": {
        "instanceId": { "type": "string", "pattern": "^winst_[A-Za-z0-9]+$" },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
      }
    },
    "StatusButtonIcon": {
      "type": "object", "additionalProperties": false, "required": ["default"], "properties": {
        "default": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "byState": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }, "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } },
        "userSelectable": { "type": "boolean" }
      }
    },
    "PackageCompositionKind": {
      "type": "string",
      "description": "Host product composition, not publisher reputation. local-trusted and admin trust tiers never grant in-process UI.",
      "enum": ["marketplace", "signed-host-product"]
    },
    "UiTier": {
      "type": "string",
      "description": "Canonical UI trust tiers. native-privileged is signed first-party product composition compiled into the host, never marketplace or publisher-trusted packages.",
      "enum": ["declarative", "a2ui", "sandboxed-web", "theme", "native-privileged"]
    },
    "UiOriginPolicy": {
      "type": "string",
      "enum": ["opaque-extension", "host-product"]
    },
    "UiAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "mediaType"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.)(?![a-z][a-z0-9+.-]*:)[a-z0-9][a-z0-9./_-]*$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mediaType": {
          "type": "string",
          "enum": [
            "text/html",
            "text/css",
            "text/javascript",
            "application/json",
            "image/png",
            "image/svg+xml",
            "image/webp",
            "application/json+a2ui",
            "application/json+theme-tokens"
          ]
        }
      }
    },
    "UiLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTreeDepth": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxStringBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxAssetBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxAssets": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "UiContributionCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "integer", "const": 2 },
        "uiBridge": { "type": "string", "minLength": 1 },
        "requiresRuntime": { "type": "boolean", "const": false }
      }
    },
    "ActionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["host-operation", "component-export"] },
        "operation": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "minLength": 1 }
      }
    },
    "ActionEnablement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": { "type": "string" },
        "disabledReason": { "type": "string" }
      }
    },
    "ProviderFamilyBrandingDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monochromeSvg", "colorPng", "accentColor"],
      "properties": {
        "monochromeSvg": { "$ref": "#/$defs/ProviderMonochromeSvgAsset" },
        "colorPng": { "$ref": "#/$defs/ProviderColorPngAsset" },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "ProviderMonochromeSvgAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "digest"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$" },
        "mediaType": { "type": "string", "const": "image/svg+xml" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "ProviderColorPngAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "digest"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?$" },
        "mediaType": { "type": "string", "const": "image/png" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "ProviderFamilyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,127}/[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "ProviderEnvironmentId": {
      "type": "string",
      "enum": ["glixo-ai-browser", "code-web-server", "tauri-windows", "tauri-macos", "tauri-linux", "android-companion", "android-paired", "ios"]
    },
    "ProviderCapabilityId": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["provider.credentials.write", "provider.oauth.pkce", "provider.oauth.browser-relay", "host.browser.popup", "host.browser.system", "host.deep-link.callback", "provider.oauth.device-code", "host.secure-secret-store", "provider.cli-proxy", "llm.execution.browser", "llm.execution.server", "llm.execution.on-device", "llm.execution.paired-device", "llm.execution.extension", "network.https-egress"]
        },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}/[a-z0-9][a-z0-9.-]{0,63}$" }
      ]
    },
    "ProviderAuthMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "flow", "protocol", "transports", "supportedEnvironments", "requiredCapabilities", "credentialBindings", "billing", "usage", "manageUrl", "runtimes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "type": "string", "enum": ["oauth", "credential"] },
        "flow": { "type": "string", "enum": ["manual-entry", "browser-authorization", "system-browser-authorization", "device-authorization", "connect-existing-service"] },
        "protocol": {
          "oneOf": [
            { "type": "string", "enum": ["none", "api-key", "oauth2-authorization-code", "oauth2-authorization-code-pkce", "oauth2-device-authorization", "cli-proxy", "provider.openrouter-pkce-key-exchange", "provider.openai-codex-oauth", "provider.gemini-oauth", "provider.managed-cliproxy-oauth"] },
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}/[a-z0-9][a-z0-9.-]{0,63}$" }
          ]
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["host-managed", "credential-form", "browser-popup", "browser-relay-popup", "system-browser", "deep-link", "native-app-link", "device-code"] }
        },
        "supportedEnvironments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderEnvironmentId" } },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderCapabilityId" } },
        "credentialBindings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" } },
        "billing": { "type": "string", "enum": ["subscription", "pay-as-you-go", "prepaid", "free-local", "user-declared"] },
        "usage": { "$ref": "#/$defs/ProviderUsageDeclaration" },
        "manageUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://[^\\s]+$" },
        "runtimes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}:[a-z0-9][a-z0-9.-]{1,127}$" } }
      }
    },
    "ProviderUsageDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "limitWindows", "spend", "balance"],
      "properties": {
        "tokens": { "const": "always" },
        "limitWindows": { "oneOf": [{ "type": "string", "enum": ["none", "built-in"] }, { "type": "string", "pattern": "^needs:[a-z0-9][A-Za-z0-9.-]{0,63}$" }] },
        "spend": { "type": "string", "enum": ["none", "built-in", "needs:adminKey", "cloudBilling"] },
        "balance": { "type": "string", "enum": ["none", "built-in", "needs:adminKey"] }
      }
    },
    "GitProviderCredentialField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "enum": ["url", "secret", "text", "oauth"] },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "helpText": { "type": "string", "maxLength": 300 },
        "defaultValue": { "type": "string", "maxLength": 256 }
      },
      "allOf": [
        { "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] }, "then": { "not": { "required": ["defaultValue"] } } }
      ]
    },
    "GitProviderAuthMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "flow", "protocol", "transports", "supportedEnvironments", "requiredCapabilities", "credentialBindings", "credentialFields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "kind": { "type": "string", "enum": ["oauth", "credential"] },
        "flow": { "type": "string", "enum": ["manual-entry", "browser-authorization", "system-browser-authorization", "device-authorization", "connect-existing-service"] },
        "protocol": { "oneOf": [
          { "type": "string", "enum": ["none", "api-key", "oauth2-authorization-code", "oauth2-authorization-code-pkce", "oauth2-device-authorization", "cli-proxy", "provider.openrouter-pkce-key-exchange", "provider.openai-codex-oauth", "provider.gemini-oauth", "provider.managed-cliproxy-oauth"] },
          { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}/[a-z0-9][a-z0-9.-]{0,63}$" }
        ] },
        "transports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["host-managed", "credential-form", "browser-popup", "browser-relay-popup", "system-browser", "deep-link", "native-app-link", "device-code"] } },
        "supportedEnvironments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderEnvironmentId" } },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderCapabilityId" } },
        "credentialBindings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" } },
        "credentialFields": { "type": "array", "items": { "$ref": "#/$defs/GitProviderCredentialField" } }
      }
    },
    "GitProviderInstanceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "label": { "type": "string", "maxLength": 80 },
        "urlLabel": { "type": "string", "maxLength": 80 },
        "placeholder": { "type": "string", "maxLength": 160 },
        "allowCustomUrl": { "type": "boolean" }
      }
    },
    "GitProviderCapabilityId": {
      "type": "string",
      "oneOf": [
        { "type": "string", "enum": ["repositories.read", "repositories.clone", "api.read", "api.write", "pullRequests.read", "pullRequests.write", "ci.read", "mcp"] },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}/[a-z0-9][a-z0-9.-]{0,63}$" }
      ]
    },
    "GitProviderMcpResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceType", "headerName", "headerValuePrefix", "credentialBinding"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "resourceType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^(?!.*[?#\u005c\u005c\u005cs])https://[^/?#@]+(?:/[^?#]*)?$" },
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[?#\u005c\u005c\u005cs]).*$" },
        "headerName": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,256}$" },
        "headerValuePrefix": { "type": "string", "maxLength": 64 },
        "credentialBinding": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "required": { "type": "boolean" },
        "requiredScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "audience": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "oneOf": [
        { "required": ["url"], "not": { "required": ["relativePath"] } },
        { "required": ["relativePath"], "not": { "required": ["url"] } }
      ]
    },
    "GitProviderMcpDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceBindings"],
      "properties": {
        "resourceBindings": { "type": "array", "items": { "$ref": "#/$defs/GitProviderMcpResourceBinding" } }
      }
    },
    "ProviderExecutionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "supportedEnvironments", "requiredCapabilities"],
      "properties": {
        "target": { "type": "string", "enum": ["browser-sandbox", "server", "on-device", "paired-device", "extension-host"] },
        "supportedEnvironments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderEnvironmentId" } },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderCapabilityId" } }
      }
    },
    "LlmAccountStatusDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interfaceVersion"],
      "properties": {
        "interfaceVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requiredScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ProviderCapabilityId" } },
        "credentialBindings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" } }
      }
    }
  }
}
