{
  "schemaVersion": 1,
  "denyByDefault": true,
  "productionFailOpen": false,
  "permissions": [
    { "id": "http.client", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "http" },
    { "id": "http.connection", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "http-connection" },
    { "id": "secret.use", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "secret-use" },
    { "id": "secret.reveal", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "secret-reveal" },
    { "id": "storage.extension", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "extension-storage" },
    { "id": "fs.handle", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "resource-handle" },
    { "id": "fs.watch", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "fs-watch" },
    { "id": "fs.unwatch", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "fs-watch" },
    { "id": "log.emit", "kind": "privileged-import", "reasonRequired": false, "scopeSchema": "telemetry" },
    { "id": "clock.read", "kind": "privileged-import", "reasonRequired": false, "scopeSchema": "none" },
    { "id": "random.read", "kind": "privileged-import", "reasonRequired": false, "scopeSchema": "none" },
    { "id": "events.publish", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "event" },
    { "id": "events.subscribe", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "event" },
    { "id": "host.action", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "host-action" },
    { "id": "ui.surface", "kind": "exported-contribution", "reasonRequired": true, "scopeSchema": "ui-surface" },
    { "id": "mcp.call", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "mcp" },
    { "id": "tool.invoke", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "tool" },
    { "id": "data.query", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "data-query" },
    { "id": "service.activate", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "service" },
    { "id": "fs.workspace.read", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "workspace-read" },
    { "id": "fs.workspace.search", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "workspace-read" },
    { "id": "message.metadata.read", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "message" },
    { "id": "message.content.read", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "message" },
    { "id": "message.input.transform", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "message" },
    { "id": "message.output.transform", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "message" },
    { "id": "target.operate", "kind": "privileged-import", "reasonRequired": true, "scopeSchema": "target" },
    { "id": "contribution.llm", "kind": "exported-contribution", "reasonRequired": false, "scopeSchema": "none" },
    { "id": "contribution.storage", "kind": "exported-contribution", "reasonRequired": false, "scopeSchema": "none" },
    { "id": "host.compat", "kind": "host-compatibility-claim", "reasonRequired": false, "scopeSchema": "none" }
  ],
  "scopeSchemas": {
    "none": { "type": "object", "additionalProperties": false },
    "http": { "type": "object", "properties": { "hosts": { "type": "array", "items": { "type": "string" } }, "methods": { "type": "array" } } },
    "http-connection": { "type": "object", "additionalProperties": false, "required": ["endpoints", "methods", "paths"], "properties": { "endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "methods": { "type": "array", "items": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] } }, "paths": { "type": "array", "items": { "type": "string", "pattern": "^/[^?#]*$" } } } },
    "workspace-read": { "type": "object", "additionalProperties": false, "required": ["projects"], "properties": { "projects": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "maxBytes": { "type": "integer", "minimum": 1, "maximum": 131072 } } },
    "message": { "type": "object", "additionalProperties": false, "properties": { "sessions": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "secret-use": { "type": "object", "properties": { "names": { "type": "array" }, "via": { "enum": ["http-injection"] } } },
    "secret-reveal": { "type": "object", "properties": { "names": { "type": "array" } } },
    "extension-storage": { "type": "object", "additionalProperties": false, "required": ["prefixes"], "properties": { "prefixes": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 512 } } } },
    "resource-handle": { "type": "object", "properties": { "roots": { "type": "array" } } },
    "fs-watch": { "type": "object", "properties": { "roots": { "type": "array" }, "recursive": { "type": "boolean" }, "handle": { "type": "string" } } },
    "telemetry": { "type": "object", "properties": { "levels": { "type": "array" } } },
    "event": { "type": "object", "properties": { "types": { "type": "array" }, "scope": { "type": "string" }, "publisherPackageId": { "type": "string" }, "publisherKinds": { "type": "array" } } },
    "host-action": { "type": "object", "properties": { "actions": { "type": "array" } } },
    "ui-surface": { "type": "object", "additionalProperties": false, "required": ["contributions", "placements"], "properties": { "contributions": { "type": "array", "items": { "type": "string" } }, "placements": { "type": "array", "items": { "type": "string" } } } },
    "mcp": { "type": "object", "properties": { "servers": { "type": "array" }, "tools": { "type": "array" } } },
    "tool": { "type": "object", "properties": { "tools": { "type": "array" }, "confirmation": { "type": "string" } } },
    "data-query": { "type": "object", "properties": { "sources": { "type": "array" }, "maxResults": { "type": "integer" } } },
    "service": { "type": "object", "properties": { "services": { "type": "array" }, "archetypes": { "type": "array" } } },
    "target": { "type": "object", "properties": { "targetIds": { "type": "array" }, "operations": { "type": "array" } } }
  }
}
