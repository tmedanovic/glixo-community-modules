{
  "description": "MCP Streamable HTTP keeps the opaque session header host-provided and uses JSON-RPC request IDs for correlation.",
  "endpointPath": "/mcp",
  "steps": [
    { "method": "POST", "jsonrpc": "2.0", "id": 1, "methodName": "initialize", "protocolVersion": "2025-06-18" },
    { "status": 200, "headers": { "Content-Type": "application/json", "Mcp-Session-Id": "opaque-host-session" }, "resultId": 1 },
    { "method": "POST", "headers": { "Mcp-Session-Id": "opaque-host-session" }, "notification": "notifications/initialized" },
    { "method": "POST", "headers": { "Mcp-Session-Id": "opaque-host-session" }, "jsonrpc": "2.0", "id": 2, "methodName": "tools/call", "tool": "issues.lookup", "arguments": { "issueKey": "DEMO-17" } },
    { "status": 200, "resultId": 2, "expect": "bounded issue metadata only" }
  ],
  "limits": { "maxResponseBytes": 131072, "timeoutMs": 15000, "maxIssueResults": 10 }
}
