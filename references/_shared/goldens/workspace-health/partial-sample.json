{
  "description": "A truncated host file listing is a bounded sample, never a complete project total.",
  "request": {
    "kind": "tool",
    "contributionId": "workspace-health.inspect",
    "configuration": {},
    "input": { "maxFiles": 2 },
    "context": { "resourceHandles": { "workspace": "host-issued" } }
  },
  "hostSearchResult": {
    "items": [
      { "path": "src/main.cs", "bytes": 240 },
      { "path": "README.md", "bytes": 80 }
    ],
    "truncated": true
  },
  "expectedResponse": {
    "sampledFiles": 2,
    "sampledBytes": 320,
    "truncated": true,
    "completeProjectTotals": null,
    "largestFiles": ["src/main.cs", "README.md"]
  }
}
