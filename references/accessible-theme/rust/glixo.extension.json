{
  "$schema": "https://schemas.glixo.dev/extension-manifest/v2.json",
  "schemaVersion": 2,
  "id": "{{PACKAGE_ID}}",
  "version": "0.1.0",
  "metadata": { "name": "{{NAME}}", "description": "An installable sandboxed appearance panel with a host-themed user control and a persisted example preference.", "license": "MIT" },
  "compatibility": { "schema": 2, "witWorld": "glixo:contribution/contribution@1.0.0", "uiBridge": "sandboxed-web.v1" },
  "components": [
    { "id": "panel-ui", "cell": "browser", "runtime": "sandboxed-web", "artifact": "ui/index.html", "digest": "sha256:8016f7bb1b1a6e72c1da22cc01d3b6534b32a68f308e0135d2219180ef6d529b" },
    { "id": "panel-actions", "cell": "server", "runtime": "wasm-component", "artifact": "dist/glixo-extension.component.wasm", "world": "glixo:contribution/contribution@1.0.0" }
  ],
  "permissions": { "requested": [
    { "id": "storage.extension", "scope": { "prefixes": ["accessible-theme/preferences/"] }, "reason": "Persist only the panel's selected appearance preference in this extension's namespaced storage." },
    { "id": "ui.surface", "scope": { "contributions": ["themed-custom-panel"], "placements": ["settings.extensions"] }, "reason": "Materialize this sandboxed settings panel only at its declared extension-settings placement." },
    { "id": "host.action", "scope": { "actions": ["save-preferences"] }, "reason": "Invoke only the panel's declared preference-saving action through the host bridge." }
  ] },
  "contributions": {
    "surfaces": [
      { "id": "themed-custom-panel", "uiTier": "sandboxed-web", "title": "Personal appearance", "placements": ["settings.extensions"], "origin": "opaque-extension", "component": "panel-ui", "assets": [{ "path": "ui/index.html", "digest": "sha256:8016f7bb1b1a6e72c1da22cc01d3b6534b32a68f308e0135d2219180ef6d529b", "mediaType": "text/html" }], "actions": [{ "kind": "action", "id": "save-preferences" }], "compatibility": { "schema": 2, "uiBridge": "sandboxed-web.v1", "requiresRuntime": false } }
    ],
    "actions": [
      { "id": "save-preferences", "title": "Save appearance preference", "component": "panel-actions", "placements": ["settings.extensions"], "context": "project", "parameters": { "type": "object", "additionalProperties": false, "required": ["accent", "largeControls"], "properties": { "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "largeControls": { "type": "boolean" } } }, "result": { "type": "object", "additionalProperties": false, "required": ["accepted"], "properties": { "accepted": { "type": "boolean" } } }, "timeoutMs": 5000, "cancellable": true }
    ]
  }
}
