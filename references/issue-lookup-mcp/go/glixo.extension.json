{
  "$schema": "https://schemas.glixo.dev/extension-manifest/v2.json",
  "schemaVersion": 2,
  "id": "{{PACKAGE_ID}}",
  "version": "0.1.0",
  "metadata": {
    "name": "{{NAME}}",
    "description": "Look up a bounded issue summary through an approved MCP connection.",
    "license": "MIT"
  },
  "components": [
    {
      "id": "issue-lookup",
      "cell": "server",
      "runtime": "wasm-component",
      "artifact": "dist/glixo-extension.component.wasm",
      "world": "glixo:contribution/contribution@1.0.0"
    }
  ],
  "permissions": {
    "requested": [
      {
        "id": "http.connection",
        "scope": {
          "endpoints": [
            "issues"
          ],
          "methods": [
            "POST"
          ],
          "paths": [
            "/mcp"
          ]
        },
        "reason": "Call only the locally approved issues MCP endpoint using its invocation-scoped opaque connection handle."
      }
    ]
  },
  "configurations": [
    {
      "id": "issue-lookup",
      "scope": "installation",
      "schema": "configuration.schema.json",
      "schemaDigest": "sha256:67fbae7ab73a4af2edf41deb2de8980eb67453f8dc7b5f688a82b45c0bb6e87b"
    }
  ],
  "contributions": {
    "tools": [
      {
        "id": "issue-lookup",
        "component": "issue-lookup",
        "configuration": "issue-lookup",
        "description": "Look up a bounded issue summary from the approved issues MCP connection.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issueKey"
          ],
          "properties": {
            "issueKey": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{0,9}-[1-9][0-9]{0,8}(?![\\s\\S])",
              "maxLength": 20
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issueKey",
            "summary"
          ],
          "properties": {
            "issueKey": {
              "type": "string"
            },
            "summary": {
              "type": "string",
              "maxLength": 65536
            }
          }
        },
        "safety": "readonly",
        "timeoutMs": 15000,
        "cancellable": true,
        "idempotent": true,
        "export": "guest.invoke"
      }
    ]
  }
}
