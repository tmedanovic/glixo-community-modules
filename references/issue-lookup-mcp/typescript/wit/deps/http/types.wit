package glixo:http@3.0.0;

interface types {
  record endpoint-grant { name: string, handle: string, base-url: string }
  record header { name: string, value: string }
  record http-request {
    url: string,
    method: string,
    headers: list<header>,
    body: option<list<u8>>,
    content-type: option<string>,
    timeout-ms: option<u32>,
    max-response-bytes: option<u32>,
    accepted-status-min: option<u16>,
    accepted-status-max: option<u16>,
    endpoint-handle: option<string>,
    secret-handle: option<string>,
    auth-header: option<string>,
    auth-scheme: option<string>,
  }
}
