{
  "schemaVersion": 2,
  "id": "{{PACKAGE_ID}}",
  "version": "0.1.0",
  "metadata": { "name": "{{NAME}}", "description": "Summarizes bounded file inventory from the selected host-owned workspace." },
  "compatibility": { "schema": 2, "witWorld": "glixo:contribution/contribution@1.0.0" },
  "components": [
    { "id": "inspect", "cell": "server", "runtime": "wasm-component", "artifact": "dist/glixo-extension.component.wasm", "world": "glixo:contribution/contribution@1.0.0" }
  ],
  "permissions": {
    "requested": [
      { "id": "tool.invoke", "scope": { "tools": ["inspect"] }, "reason": "Expose the read-only workspace inventory summary as an explicitly invoked tool." },
      { "id": "fs.workspace.search", "scope": { "projects": ["selected"] }, "reason": "List bounded relative paths and file sizes only from the host-selected project." }
    ]
  },
  "contributions": {
    "tools": [
      {
        "id": "inspect", "component": "inspect", "world": "glixo:contribution/contribution@1.0.0",
        "description": "Summarize a bounded sample of relative workspace paths and file sizes; report eligible-file totals only when the host says the listing is complete.",
        "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "maxFiles": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 } } },
        "outputSchema": {
          "type": "object", "additionalProperties": false,
          "required": ["sampledFiles", "sampledBytes", "truncated", "eligibleFileTotals", "sampledExtensions", "largestFiles"],
          "properties": {
            "sampledFiles": { "type": "integer", "minimum": 0 },
            "sampledBytes": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "eligibleFileTotals": { "type": ["object", "null"], "description": "Totals for files included by the broker traversal; it omits ignored folders and reparse points, so it is not a total for every filesystem entry.", "properties": { "fileCount": { "type": "integer" }, "bytes": { "type": "integer" } } },
            "sampledExtensions": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "largestFiles": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes"], "properties": { "path": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 } } } }
          }
        },
        "safety": "readonly", "timeoutMs": 5000, "cancellable": true, "idempotent": true
      }
    ]
  }
}
