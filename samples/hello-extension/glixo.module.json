{
  "id": "glixo.samples.hello-extension",
  "name": "Hello Extension",
  "description": "Minimal client contribution sample with a settings panel and command.",
  "icon": "assets/icon.svg",
  "images": [
    {
      "url": "assets/screenshot.svg",
      "alt": "Hello Extension settings and command preview",
      "caption": "Minimal extension with a settings panel and command palette action.",
      "type": "screenshot"
    }
  ],
  "changelog": {
    "entries": [
      {
        "version": "0.1.0",
        "date": "2026-06-25",
        "title": "Installable starter sample",
        "description": "Adds a tiny client contribution that exercises catalog preview, install, config, health, logs, and lifecycle."
      }
    ]
  },
  "kind": "extension",
  "version": "0.1.0",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["hello-panel/index.js"] },
  "capabilities": ["glixo.samples.hello"],
  "requires": ["ui", "logging", "health", "config"],
  "permissions": ["logs.read"],
  "health": { "path": "/health", "intervalSeconds": 30 },
  "config": {
    "fields": [
      {
        "key": "greeting",
        "label": "Greeting",
        "type": "text",
        "required": false,
        "defaultValue": "Hello from Glixo"
      }
    ]
  },
  "components": [
    {
      "id": "hello-panel",
      "cell": "client",
      "scope": "user",
      "runtime": "node",
      "entry": { "command": "node", "args": ["index.js"], "workingDirectory": "hello-panel" },
      "requires": ["ui", "logging", "health", "config"],
      "capabilities": ["glixo.samples.hello"],
      "placement": { "kind": "user", "required": true }
    }
  ],
  "contributes": {
    "settingsPanels": [
      {
        "id": "glixo.samples.hello.settings",
        "slot": "settings",
        "title": "Hello Extension",
        "component": "HelloExtensionSettings"
      }
    ],
    "actions": [
      {
        "id": "glixo.samples.hello.sayHello",
        "slot": "command.palette",
        "title": "Say hello",
        "command": "glixo.samples.hello.sayHello"
      }
    ]
  },
  "artifacts": [
    {
      "rid": "any",
      "url": "artifacts/hello-extension-0.1.0.zip",
      "sha256": "4b5df9be80b97f38b080badc9e02748d897d664cc9a8e868fe00125910812376"
    }
  ],
  "updateChannels": ["stable"]
}
