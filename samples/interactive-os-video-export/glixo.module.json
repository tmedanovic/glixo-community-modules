{
  "id": "glixo.samples.interactive-os-video-export",
  "name": "Interactive OS Video Export",
  "description": "Client action sample that adds a download-as-video command to Interactive OS sessions.",
  "kind": "extension",
  "version": "0.1.0",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "echo", "args": ["client-bundled-in-app"] },
  "capabilities": ["glixo.interactiveOs.video.export"],
  "requires": ["ui", "capability.glixo.interactiveOs.timeline"],
  "permissions": ["browser.capture"],
  "health": { "path": "/health", "intervalSeconds": 30 },
  "components": [
    {
      "id": "video-export-action",
      "cell": "client",
      "scope": "session",
      "runtime": "node",
      "entry": { "command": "echo", "args": ["client-bundled-in-app"] },
      "requires": ["ui", "capability.glixo.interactiveOs.timeline"],
      "capabilities": ["glixo.interactiveOs.video.export"],
      "placement": { "kind": "session", "required": false }
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "glixo.interactiveOs.downloadVideo.button",
        "slot": "interactive-os.toolbar",
        "title": "Download video",
        "command": "glixo.interactiveOs.downloadVideo"
      }
    ]
  },
  "artifacts": [
    {
      "rid": "any",
      "url": "artifacts/interactive-os-video-export-0.1.0.zip",
      "sha256": "3086f6d879d1dfdd388a8582463978cd03960342ad0c205120fdaf612301273d"
    }
  ],
  "updateChannels": ["stable"]
}
