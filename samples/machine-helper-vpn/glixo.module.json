{
  "id": "glixo.samples.machine-helper-vpn",
  "name": "Machine Helper VPN",
  "description": "Selected-machine target component sample for VPN/client-helper style extensions.",
  "catalog": {
    "listed": false,
    "reason": "Hidden until remote target transport, start/health, and secret-reference handling are product-ready."
  },
  "kind": "extension",
  "version": "0.1.0",
  "protocolVersion": "0",
  "runtime": { "kind": "node", "version": "20" },
  "entry": { "command": "node", "args": ["index.js"], "workingDirectory": "vpn-client-helper" },
  "capabilities": ["glixo.machine.vpn.connect", "glixo.machine.vpn.status"],
  "requires": ["logging", "health", "config", "secrets.vpn", "capability.glixo.machine.v1"],
  "permissions": ["network.vpn", "secrets.read"],
  "health": { "path": "/health", "intervalSeconds": 30 },
  "components": [
    {
      "id": "vpn-client-helper",
      "cell": "target",
      "scope": "machine",
      "runtime": "node",
      "entry": { "command": "node", "args": ["index.js"], "workingDirectory": "vpn-client-helper" },
      "requires": ["logging", "health", "config", "secrets.vpn"],
      "capabilities": ["glixo.machine.vpn.connect", "glixo.machine.vpn.status"],
      "placement": {
        "kind": "selectedMachines",
        "required": true,
        "defaultEnabled": false,
        "prompt": "Choose machines that should receive the VPN client helper.",
        "minTargets": 1
      }
    },
    {
      "id": "vpn-settings",
      "cell": "client",
      "scope": "user",
      "runtime": "node",
      "entry": { "command": "echo", "args": ["client-bundled-in-app"] },
      "requires": ["ui", "capability.glixo.machine.vpn.status"],
      "capabilities": ["glixo.machine.vpn.configure"]
    }
  ],
  "config": {
    "fields": [
      { "key": "profileName", "label": "VPN profile", "type": "text", "required": true },
      { "key": "serverUrl", "label": "VPN server URL", "type": "text", "required": true },
      { "key": "credentialRef", "label": "VPN credential reference", "type": "secret", "required": true }
    ]
  },
  "contributes": {
    "settingsPanels": [
      {
        "id": "glixo.samples.machineVpn.settings",
        "slot": "settings",
        "title": "Machine VPN",
        "component": "MachineVpnSettings"
      }
    ]
  },
  "artifacts": [
    {
      "rid": "any",
      "url": "artifacts/machine-helper-vpn-0.1.0.zip",
      "sha256": "99f060579cef4715d351650f1a95a3c226d11b65f994ab72691ac010806b411e"
    }
  ],
  "updateChannels": ["stable"]
}
